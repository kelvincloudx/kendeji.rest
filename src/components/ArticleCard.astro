---
interface Props {
  article: {
    slug: string;
    title: string;
    description: string;
    publishDate: string;
    updateDate: string;
    readTime: string;
    summary: string;
  };
  index: number;
}

const { article, index } = Astro.props;
---

<div class="article-item">
  <div class="article-meta-row">
    <span class="article-index">0{index + 1}</span>
    <time class="article-date" datetime={article.publishDate}>{article.publishDate}</time>
    <span class="article-read-time">{article.readTime}</span>
  </div>

  <div class="article-body">
    <h3 class="article-title">
      <a href={`/articles/${article.slug}/`} class="article-link">
        {article.title}
      </a>
    </h3>
    <p class="article-summary">{article.summary}</p>
  </div>

  <div class="article-action">
    <a href={`/articles/${article.slug}/`} class="read-more-btn" aria-label={`阅读全文：${article.title}`}>
      <span>阅读全文</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .article-item {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .article-item:last-child {
    border-bottom: none;
  }

  .article-item:hover {
    border-color: #fed7aa;
  }

  .article-meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .article-index {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ea580c;
    font-family: monospace;
  }

  .article-date {
    font-size: 0.82rem;
    color: #64748b;
  }

  .article-read-time {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .article-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .article-link {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-link:hover,
  .article-link:focus-visible {
    color: #ea580c;
  }

  .article-summary {
    margin: 0;
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-action {
    flex-shrink: 0;
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #ea580c;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.95rem;
    border: 1px solid #fed7aa;
    border-radius: 6px;
    background: #fff7ed;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .read-more-btn:hover,
  .read-more-btn:focus-visible {
    background: #ffedd5;
    border-color: #ea580c;
    transform: translateX(2px);
  }

  @media (max-width: 768px) {
    .article-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.25rem 0;
    }

    .article-meta-row {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }

    .article-title {
      font-size: 1.05rem;
    }

    .article-action {
      margin-top: 0.25rem;
    }
  }
</style>
