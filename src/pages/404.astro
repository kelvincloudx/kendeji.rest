---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';

const pageTitle = `页面未找到 (404) - ${siteConfig.name}`;
const pageDescription = '您访问的页面不存在或已被移除，请返回肯の基机场首页查看完整套餐与教程。';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://kendeji.rest/404.html"
>
  <div class="container error-container">
    <div class="error-box">
      <div class="error-code">404</div>
      <h1 class="error-title">抱歉，您访问的页面不存在</h1>
      <p class="error-desc">
        该页面可能已被移动、更名或链接已过期。您可以返回肯の基机场首页查看最新的套餐价格、上手教程与精选知识文章。
      </p>
      <div class="error-actions">
        <a href="/" class="btn-primary">返回网站首页</a>
        <a href="/#pricing" class="btn-secondary">查看套餐价格</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    padding: 6rem 1.25rem;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
  }

  .error-box {
    text-align: center;
    max-width: 540px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    padding: 3rem 2rem;
  }

  .error-code {
    font-size: 5rem;
    font-weight: 900;
    color: #ea580c;
    line-height: 1;
    margin-bottom: 1rem;
    font-family: monospace;
  }

  .error-title {
    font-size: 1.6rem;
    color: #0f172a;
    margin: 0 0 1rem 0;
  }

  .error-desc {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn-primary:hover {
    opacity: 0.92;
  }

  .btn-secondary {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
</style>
